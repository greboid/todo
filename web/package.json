{
  "name": "todo-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run copy:swagger",
    "copy:swagger": "mkdir -p ../internal/api/swagger-ui && cp node_modules/swagger-ui-dist/swagger-ui-bundle.js node_modules/swagger-ui-dist/swagger-ui.css node_modules/swagger-ui-dist/LICENSE node_modules/swagger-ui-dist/NOTICE ../internal/api/swagger-ui/",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "svelte": "^5.57.3",
    "swagger-ui-dist": "^5.34.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  }
}

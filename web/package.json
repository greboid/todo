{
  "name": "todo-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run copy:swagger",
    "copy:swagger": "mkdir -p ../internal/api/swagger-ui && cp node_modules/swagger-ui-dist/swagger-ui-bundle.js node_modules/swagger-ui-dist/swagger-ui.css node_modules/swagger-ui-dist/LICENSE node_modules/swagger-ui-dist/NOTICE ../internal/api/swagger-ui/",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "svelte": "^5.57.0",
    "swagger-ui-dist": "^5.32.15",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  }
}
